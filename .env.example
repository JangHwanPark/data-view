# data-view settings example. Copy this file to .env.local and fill in values.
# .env.local is not committed to git. Restart the app after changing it.

# Folders the app may read (tables, design docs, .env files). Separate several with ;
# The fixtures folder (fake test data) is always allowed.
# DATA_VIEW_ROOTS=D:\game\table;D:\game\docs

# DB connection used by "Load from environment variables" (any prefix ending with DB_ works).
# GAME_DB_HOST=127.0.0.1
# GAME_DB_PORT=3306
# GAME_DB_USER=reader
# GAME_DB_PASSWORD=
# GAME_DB_NAME=game

# 1 = allow typing a DB password on screen and saving it encrypted. Off by default.
# DATA_VIEW_SAVE_DB_PASSWORDS=1

# Folder for the encryption key. Default: %APPDATA%\data-view on Windows, ~/.config/data-view elsewhere.
# DATA_VIEW_KEY_DIR=

# Extra host names allowed to call the API besides 127.0.0.1 and localhost. Separate with ;
# DATA_VIEW_ALLOWED_HOSTS=

# Qdrant vector DB (read only). The API key stays on this PC and is never sent to the browser.
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
